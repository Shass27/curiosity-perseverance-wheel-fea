# encoding: utf-8
# 2025 R1
SetScriptVersion(Version="25.1.122")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
engineeringData1 = system1.GetContainer(ComponentName="Engineering Data")
matl1 = engineeringData1.CreateMaterial(Name="Al ")
matl1 = engineeringData1.CreateMaterial(Name="Al 7075-T7351")
matlProp1 = matl1.CreateProperty(
    Name="Elasticity",
    Behavior="Isotropic",
    Qualifiers={"Definition": "", "Behavior": "Isotropic"})
matlProp1.SetData(
    Index=-1,
    Variables=["Young's Modulus"],
    Values=[["71700 [MPa]"]])
matlProp1.SetData(
    Variables=["Poisson's Ratio"],
    Values=[["0.33"]])
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("MOS_Project/CAD_models/Tier 1/a=2.STEP"))
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("MOS_Project/CAD_models/Tier 1/a=4.STEP"))
model1.Exit()
modelComponent1.Refresh()
model1.Edit()
model1.Exit()
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("MOS_Project/CAD_models/Tier 1/a=6.STEP"))
modelComponent1.Refresh()
model1.Edit()
results1 = system1.GetContainer(ComponentName="Results")
results1.Edit()
model1.Exit()
geometryComponent1 = system1.GetComponent(Name="Geometry")
geometryComponent1.Reset()
Save(Overwrite=True)
